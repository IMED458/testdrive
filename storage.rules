rules_version = '2';

// Storage — ხმოვანი ფაილები.
// კითხვა ყველასთვის (გამოცდის დროს ხმა უნდა ჩაიტვირთოს),
// ატვირთვა მხოლოდ ადმინისთვის და მხოლოდ ხმოვანი ფაილი 5 მბ-მდე.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    match /audio/{lang}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
